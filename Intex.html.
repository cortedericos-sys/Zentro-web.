  </main>

  <footer>
    <a href="#inicio" class="logo">ZENTRO<span>.</span></a>
    <p>© <span id="ano"></span> Zentro Web. Todos os direitos reservados.</p>
    <p>A tua presença digital começa aqui.</p>
  </footer>

  <a class="whatsapp-flutuante"
     href="https://wa.me/244935020251?text=Ol%C3%A1%2C%20Zentro%20Web!"
     target="_blank" rel="noopener"
     aria-label="Contactar a Zentro Web pelo WhatsApp">
    ☎
