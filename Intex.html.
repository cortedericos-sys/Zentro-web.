
<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Zentro Web - Criação de sites modernos, lojas online e soluções digitais em Angola.">
  <title>Zentro Web | A tua presença digital</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --azul: #087bff;
      --azul-claro: #00b7ff;
      --fundo: #07090e;
      --cartao: #10141d;
      --branco: #ffffff;
      --cinza: #a5adbb;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--fundo);
      color: var(--branco);
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 7%;
      border-bottom: 1px solid #1b2230;
      background: #080a10;
    }

    .logo {
      font-size: 24px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .logo span {
      color: var(--azul);
    }

    nav {
      display: flex;
      gap: 22px;
      align-items: center;
    }

    nav a {
      font-size: 14px;
      color: #d8deea;
    }

    nav a:hover {
      color: var(--azul-claro);
    }

    .botao {
      display: inline-block;
      background: linear-gradient(110deg, var(--azul), var(--azul-claro));
      color: white;
      padding: 13px 22px;
      border-radius: 7px;
      font-weight: bold;
      border: none;
      transition: 0.25s;
    }

    .botao:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px #087bff40;
    }

    .hero {
      min-height: 580px;
      display: flex;
      align-items: center;
      padding: 75px 8%;
      background:
        radial-gradient(ellipse at 80% 40%, #073d842d, transparent 48%),
        var(--fundo);
    }

    .hero-conteudo {
      max-width: 720px;
    }

    .etiqueta {
      display: inline-block;
      color: var(--azul-claro);
      border: 1px solid #087bff66;
      padding: 6px 12px;
      border-radius: 30px;
      font-size: 12px;
      margin-bottom: 20px;
    }

    h1 {
      font-size: clamp(38px, 7vw, 66px);
      line-height: 1.12;
      margin-bottom: 22px;
      letter-spacing: -2px;
    }

    h1 span {
      color: var(--azul);
    }

    .hero p {
      color: var(--cinza);
      font-size: 17px;
      max-width: 570px;
      margin-bottom: 30px;
    }

    .botoes {
      display: flex;
      gap: 13px;
      flex-wrap: wrap;
    }

    .botao-secundario {
      display: inline-block;
      padding: 12px 22px;
      border: 1px solid #343c4c;
      border-radius: 7px;
      font-weight: bold;
    }

    section {
      padding: 75px 8%;
    }

    .titulo {
      text-align: center;
      margin-bottom: 42px;
    }

    .titulo h2 {
      font-size: 34px;
      margin-bottom: 10px;
    }

    .titulo h2 span {
      color: var(--azul);
    }

    .titulo p {
      color: var(--cinza);
    }

    .servicos {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    .servico {
      background: var(--cartao);
      border: 1px solid #222b3b;
      padding: 26px;
      border-radius: 12px;
      transition: 0.25s;
    }

    .servico:hover {
      border-color: var(--azul);
      transform: translateY(-5px);
    }

    .icone {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      background: #087bff20;
      border-radius: 10px;
      color: var(--azul-claro);
      font-size: 23px;
      margin-bottom: 18px;
    }

    .servico h3 {
      margin-bottom: 10px;
      font-size: 19px;
    }

    .servico p {
      color: var(--cinza);
      font-size: 14px;
    }

    .sobre {
      background: #0c1018;
      text-align: center;
    }

    .sobre-conteudo {
      max-width: 720px;
      margin: auto;
    }

    .sobre p {
      color: var(--cinza);
      margin: 16px 0 25px;
    }

    .contacto {
      text-align: center;
      background:
        radial-gradient(ellipse at center, #073d842b, transparent 65%);
    }

    .contacto p {
      color: var(--cinza);
      margin: 12px 0 25px;
    }

    footer {
      padding: 25px 8%;
      border-top: 1px solid #1b2230;
      display: flex;
      justify-content: space-between;
      gap: 15px;
      flex-wrap: wrap;
      color: var(--cinza);
      font-size: 13px;
    }

    .whatsapp-flutuante {
      position: fixed;
      right: 18px;
      bottom: 18px;
      width: 57px;
      height: 57px;
      border-radius: 50%;
      background: #20c968;
      color: white;
      display: grid;
      place-items: center;
      font-size: 27px;
      box-shadow: 0 5px 20px #0008;
      z-index: 100;
    }

    @media (max-width: 760px) {
      header {
        padding: 16px 5%;
      }

      nav {
        gap: 12px;
      }

      nav a {
        font-size: 12px;
      }

      nav .botao {
        padding: 9px 12px;
      }

      .hero {
        min-height: 510px;
        padding: 65px 6%;
      }

      section {
        padding: 60px 6%;
      }

      .servicos {
        grid-template-columns: 1fr;
      }

      .titulo h2 {
        font-size: 29px;
      }

      footer {
        text-align: center;
        justify-content: center;
      }
    }

    @media (max-width: 380px) {
      .logo {
        font-size: 20px;
      }

      nav {
        gap: 8px;
      }

      nav a {
        font-size: 11px;
      }
    }
  </style>
</head>

<body>

  <header>
    <a href="#inicio" class="logo">ZENTRO<span>.</span></a>

